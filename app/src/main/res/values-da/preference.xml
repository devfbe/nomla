    <string name="speexNoiseSuppressMedium">Middel (−25 dB)</string>
    <string name="speexNoiseSuppressHigh">Dyb (−35 dB)</string>
    <string name="androidNoiseSuppressor">Enhedens støjdæmpning</string>
    <string name="androidNoiseSuppressorSum">Brug også telefonens egen støjdæmpningseffekt på mikrofonen.</string>
    <string name="androidAgc">Enhedens lydstyrkeregulering</string>
    <string name="androidAgcSum">Brug også telefonens egen automatiske forstærkningsregulering på mikrofonen.</string>
    <string name="audioEffectUnavailable">Ikke tilgængelig på denne enhed.</string>
    <string name="vadMode">Sådan registreres tale</string>
    <string name="vadModeSum">De øvrige indstillinger i dette afsnit afhænger af dette valg.</string>
    <string name="vadModeAdaptive">Automatisk (anbefalet)</string>
    <string name="vadModeAmplitude">Fast lydstyrkeniveau (klassisk)</string>
    <string name="vadModeProbability">Talemodel</string>
    <string name="vadSensitivity">Registreringstærskel</string>
    <string name="vadSensitivitySum">Hvor tærsklen ligger mellem den målte baggrundsstøj og din målte stemme. Højere betyder, at du skal skille dig tydeligere ud fra rummet; lavere lukker mere igennem. Bjælken nedenfor viser begge mærker i bevægelse.</string>
    <string name="vadAdaptiveFloor">Følg baggrundsstøjen</string>
    <string name="vadAdaptiveFloorSum">Måler løbende, hvor støjende rummet er, og flytter tærsklen med. Slå fra for at indstille niveauet manuelt.</string>
    <string name="vadFloor">Baggrundsniveau</string>
    <string name="vadFloorSum">Rumniveauet, som tærsklen måles fra, i dB under fuld skala. Bruges kun, når \"Følg baggrundsstøjen\" er slået fra.</string>
    <string name="vadRecalibrate">Mål igen</string>
    <string name="vadRecalibrateSum">Glemmer det, der er lært om rummet og din stemme, og begynder at måle forfra.</string>
    <string name="vadOnset">Ignorer korte lyde</string>
    <string name="vadOnsetSum">Hvor længe en lyd skal vare, før den tæller som tale. Længere indstillinger holder enkelte tastaturklik ude; hvert trin koster 10 ms af begyndelsen af et ord.</string>
    <string name="vadOnsetOff">Fra (0 ms)</string>
    <string name="vadOnset2">Korte klik (10 ms)</string>
    <string name="vadOnset3">Kraftigere (20 ms)</string>
    <string name="vadOnset4">Kraftigst (30 ms)</string>
    <string name="vadHold">Holdetid</string>
    <string name="vadHoldSum">Bliv ved med at sende så længe efter, at din stemme falder under tærsklen, så pauser midt i en sætning ikke klippes af.</string>
    <string name="vadStart">Starttærskel</string>
    <string name="vadStartSum">Talesandsynlighed, hvor afsendelsen starter.</string>
    <string name="vadStop">Stoptærskel</string>
    <string name="vadStopSum">Talesandsynlighed, under hvilken afsendelsen stopper.</string>
    <string name="detectionThresholdMigration">Fra denne version måles niveauet efter støjdæmpningen, så en gammel indstilling svarer til en anden lydstyrke end før. \"Automatisk\" kræver ingen kalibrering.</string>
    <string name="inputLevelMeter">Indgangsniveau</string>
    <string name="inputLevelMeterSum">Live mikrofonniveau med mærker for baggrund og tærskel.</string>
    <string name="inputLevelMeterUnavailable">Mikrofonen er ikke tilgængelig – tilladelse mangler, eller en anden app bruger den.</string>
    <string name="inputLevelMeterReading">%1$s dBFS · rum %2$s · tærskel %3$s · stemme %4$s</string>
    <string name="inputLevelMeterTooClose">Din stemme er knap over rummets niveau. Gå tættere på telefonen, eller gør omgivelserne mere stille.</string>
    <string name="audioLoopbackTest">Lyt til mig selv</string>
    <string name="audioLoopbackTestSum">Afspiller din bearbejdede stemme, mens dette er slået til. Brug hovedtelefoner – gennem højttaleren vil det hyle.</string>
    <string name="controls">Betjening</string>
    <string name="mediaButtonAction">Headsetknap</string>
    <string name="mediaButtonActionSum">Hvad afspil/pause-knappen på et headset med ledning eller Bluetooth gør, mens du er forbundet, også når skærmen er slukket. Tryk kort: En knap, du holder nede, gør slet ingenting, fordi Android giver det lange tryk til stemmeassistenten. Og den skifter – ét tryk slår til, det næste slår fra – mens tryk-for-snak-tasterne på skærmen og på enheden kun sender, så længe du holder dem nede, medmindre fastlåst tryk-for-snak-knap er slået til.</string>
    <string name="mediaButtonActionNone">Intet – lad medietasterne være til din musikapp</string>
    <string name="mediaButtonActionAuto">Slå tryk-for-snak til/fra, eller slå lyd fra i de andre sendetilstande</string>
    <string name="mediaButtonActionMute">Slå lyd fra/til</string>
    <string name="bluetoothSco">Brug Bluetooth-headset automatisk</string>
    <string name="bluetoothScoSum">Send og modtag tale gennem et forbundet Bluetooth-headset, mens du er forbundet til en server, og skift til et headset, der forbindes under opkaldet. Lydenheden for opkaldet kan ændres i kanalmenuen. Beder om tilladelsen \"Enheder i nærheden\"; nogle enheder sender ikke lyd til et headset uden den.</string>
    <string name="about_description">Nomla er en Mumble-klient til Android. Den blev overført fra Mumla og næsten fuldstændig omskrevet.</string>
