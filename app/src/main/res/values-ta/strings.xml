    <string name="double_talk_starting">தொடங்குகிறது…</string>
    <string name="double_talk_listen">சற்று அமைதியாக இருங்கள். குரல் தனியாகப் பேசும்போது விளக்கு இருட்டாகவே இருக்க வேண்டும்.</string>
    <string name="double_talk_talk">குரலின் மேல் பேசுங்கள். நீங்கள் பேசும்போது விளக்கு ஒளிர வேண்டும், அமைதியாக இருக்கும்போது இருட்டாக இருக்க வேண்டும்.</string>
    <string name="double_talk_stopped">சோதனை நிறுத்தப்பட்டது. மீண்டும் இயக்க «மீண்டும் முயல்» என்பதைத் தட்டவும்.</string>
    <string name="double_talk_unavailable">சோதனையைத் தொடங்க முடியவில்லை: ஓரி அல்லது ஒலிபெருக்கி கிடைக்கவில்லை.</string>
    <string name="double_talk_no_echo_cancellation">ஒலிபெருக்கிக்கு எதிரொலி நீக்கம் அணைக்கப்பட்டுள்ளது. அது இல்லாமல், நீங்கள் பேசுபவர்கள் தங்களையே கேட்கக்கூடும்.</string>
    <string name="double_talk_lamp">அனுப்புதல் விளக்கு</string>
    <string name="double_talk_lamp_on">நீங்கள் கேட்கப்படுவீர்கள்</string>
    <string name="double_talk_lamp_off">நீங்கள் கேட்கப்பட மாட்டீர்கள்</string>
    <string name="double_talk_heard">குரலின் மேல் பேசிய நேரத்தில் %1$d%% உங்களைக் கேட்டது</string>
    <string name="double_talk_heard_pending">உங்களைக் கேட்டது: அளக்கக் குரலின் மேல் பேசுங்கள்</string>
    <string name="double_talk_false_open">குரல் மட்டும் இருந்தபோது %1$d%% நேரம் திறந்தது</string>
    <string name="double_talk_false_open_pending">குரல் மட்டும் இருந்தபோது திறந்தது: அளக்கிறது…</string>
    <string name="double_talk_method">«குரலின் மேல் பேசியது» என்பது எதிரொலி நீக்கி மட்டுமே உங்களை அனுமதித்திருக்கும் தருணங்களைக் கணக்கிடுகிறது. «குரல் மட்டும்» தொடக்கத்தில் நீங்கள் அமைதியாக இருக்கும்போது அளக்கப்படுகிறது. நழுவியை நகர்த்தினால் இரண்டும் மீண்டும் தொடங்கும்.</string>
