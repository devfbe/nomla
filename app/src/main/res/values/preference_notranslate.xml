<!-- Here be constants. These resources do NOT need translation. -->
<resources>
    <string-array
        name="audioInputNames"
        translatable="false">
        <item>@string/inputMethodVoice</item>
        <item>@string/inputMethodPtt</item>
        <item>@string/inputMethodContinuous</item>
    </string-array>

    <string-array
        name="audioInputValues"
        translatable="false">
        <item>voiceActivity</item>
        <item>ptt</item>
        <item>continuous</item>
    </string-array>

    <string-array
        name="audioSampleRateValues"
        translatable="false">
        <item>48000</item>
        <item>44100</item>
        <item>16000</item>
        <item>8000</item>
    </string-array>

    <string-array name="themeNames" translatable="false">
        <item>@string/theme_system</item>
        <item>@string/theme_light</item>
        <item>@string/theme_dark</item>
    </string-array>

    <string-array name="themeValues" translatable="false">
        <item>system</item>
        <item>forceLight</item>
        <item>forceDark</item>
    </string-array>

    <string-array name="controlBarPositionNames" translatable="false">
        <item>@string/controlBarPositionBottom</item>
        <item>@string/controlBarPositionTop</item>
    </string-array>

    <!-- Must stay in lockstep with Settings.ARRAY_CONTROL_BAR_*. -->
    <string-array name="controlBarPositionValues" translatable="false">
        <item>bottom</item>
        <item>top</item>
    </string-array>

    <string-array name="hotCornerNames" translatable="false">
        <item>@string/hot_corner_none</item>
        <item>@string/hot_corner_top_left</item>
        <item>@string/hot_corner_bottom_left</item>
        <item>@string/hot_corner_top_right</item>
        <item>@string/hot_corner_bottom_right</item>
    </string-array>

    <string-array name="hotCornerValues" translatable="false">
        <item>none</item>
        <item>topLeft</item>
        <item>bottomLeft</item>
        <item>topRight</item>
        <item>bottomRight</item>
    </string-array>

    <!-- Frames of 10 ms; AudioSettingsFragment names them in milliseconds. -->
    <string-array name="audio_per_packet_values" translatable="false">
        <item>1</item>
        <item>2</item>
        <item>4</item>
        <item>6</item>
    </string-array>


    <string-array name="noiseSuppressionNames" translatable="false">
        <item>@string/noiseSuppressionNone</item>
        <item>@string/noiseSuppressionLight</item>
        <item>@string/noiseSuppressionStrong</item>
    </string-array>

    <!-- Must stay in lockstep with NoiseSuppressionMode.preferenceValue. -->
    <string-array name="noiseSuppressionValues" translatable="false">
        <item>none</item>
        <item>speex</item>
        <item>rnnoise</item>
    </string-array>

    <string-array name="speexNoiseSuppressNames" translatable="false">
        <item>@string/speexNoiseSuppressLow</item>
        <item>@string/speexNoiseSuppressMedium</item>
        <item>@string/speexNoiseSuppressHigh</item>
    </string-array>

    <!-- Must stay in lockstep with PipelineSettings.SPEEX_NOISE_SUPPRESS_DB. -->
    <string-array name="speexNoiseSuppressValues" translatable="false">
        <item>-15</item>
        <item>-25</item>
        <item>-35</item>
    </string-array>

    <string-array name="vadModeNames" translatable="false">
        <item>@string/vadModeAdaptive</item>
        <item>@string/vadModeAmplitude</item>
        <item>@string/vadModeProbability</item>
    </string-array>

    <!-- Must stay in lockstep with VadMode.preferenceValue. -->
    <string-array name="vadModeValues" translatable="false">
        <item>adaptive</item>
        <item>amplitude</item>
        <item>probability</item>
    </string-array>

    <string-array name="vadOnsetNames" translatable="false">
        <item>@string/vadOnsetOff</item>
        <item>@string/vadOnset2</item>
        <item>@string/vadOnset3</item>
        <item>@string/vadOnset4</item>
    </string-array>

    <!-- Frames of 10 ms; 1 opens on the first frame. -->
    <string-array name="vadOnsetValues" translatable="false">
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>

    <string-array name="mediaButtonActionNames" translatable="false">
        <item>@string/mediaButtonActionNone</item>
        <item>@string/mediaButtonActionAuto</item>
        <item>@string/mediaButtonActionMute</item>
    </string-array>

    <!-- Must stay in lockstep with MediaButtonAction.prefValue; pinned by
         MediaButtonActionResourcesTest. -->
    <string-array name="mediaButtonActionValues" translatable="false">
        <item>none</item>
        <item>auto</item>
        <item>mute</item>
    </string-array>

